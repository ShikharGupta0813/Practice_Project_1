# ---------------------------------------------------------------------------
# Copy this file to:  .claude/config.env    then fill it in.
#
#     powershell -File .claude/bin/setup.ps1      # copies it and checks everything
#
# config.env is YOURS. It is git-ignored and must never be committed or shared.
# Every value below is optional - anything you leave out keeps its default.
# ---------------------------------------------------------------------------


# === 1. SECRETS =============================================================

# Asana Personal Access Token.
#   app.asana.com -> your picture -> My Settings -> Apps -> Personal access tokens
#
# Pick ONE of the two lines below.
#
# (a) Keep the token in a file OUTSIDE the repo. Safest, and the default:
ASANA_TOKEN_FILE=%USERPROFILE%\.claude\.asana_token
#
# (b) Or paste it here. Convenient, but it now lives inside the repo folder -
#     only do this if you are sure config.env is git-ignored (it is by default).
# ASANA_TOKEN=1/1234567890:abcdef...

# GitHub needs NO token here. The tooling uses the `gh` CLI, which keeps its own
# login in your OS credential store:
#     gh auth login


# === 2. YOUR REPOSITORY =====================================================

# owner/name on GitHub.
GITHUB_REPO=OneStackIndia/core-php

# The branch that represents PRODUCTION. All task branches are cut from this,
# and the production PR targets it.
PROD_BRANCH=onestackcbs

# The branch that represents DEV. The first PR targets this.
# If your team uses ONE branch, set DEV_BRANCH to the same value as PROD_BRANCH
# and ignore the /prod command.
DEV_BRANCH=onestackcbs-dev


# === 3. YOU =================================================================

# Prefix for every branch the automation creates. Use your own initials.
#   e.g. ab_cl_  ->  ab_cl_fix_login_timeout
BRANCH_PREFIX=sg_cl_

# Trailer added to commits. Change it if you use a different AI, or set it to
# an empty value to add no trailer at all.
COAUTHOR_LINE=Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>


# === 4. PATHS ON YOUR MACHINE ===============================================

# Where new per-task worktrees are created. A sibling folder of the repo.
WORKTREE_ROOT=../oneStack-worktrees

# Used by the syntax gate (verify.ps1). If your project is not PHP, see the
# README - you replace the gate itself, not just this path.
PHP_BIN=C:\xampp\php\php.exe


# === 5. AI CODE REVIEW (optional) ===========================================

# Which review-pr providers to run, comma separated: claude, antigravity,
# codex, gemini. Set to just one if you only have one installed.
REVIEW_PROVIDERS=claude,antigravity

# review-pr itself is installed inside WSL - see the README. Nothing to set here.


# === 6. REFERENCE DOCS (optional) ===========================================

# A document describing your PRODUCTION database schema (tables, columns,
# indexes). Used by /task-plan only when a task actually needs schema facts.
# Leave empty if you have none.
DB_SCHEMA_DOC=

# --- nightly run -------------------------------------------------------
# See .claude/docs/nightly.md. The scheduler is NOT installed by default;
# these govern it if you set one up yourself.
# How many tasks one night may touch.
NIGHTLY_MAX_TASKS=4
# Above this many files, an AUTO verdict is downgraded to ASK.
NIGHTLY_AUTO_MAX_FILES=6
# Whether a finished task may open its dev PR with nobody awake.
# Leave false until you trust the verdicts.
NIGHTLY_OPEN_DEV_PR=false
# Per task, per phase.
NIGHTLY_TIMEOUT_MINUTES=25
